# Local API only. Copy to apps/api/.env; never commit the populated file.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
APP_ORIGIN=http://localhost:3000
DATABASE_DRIVER=pglite
# Relative to apps/api when running pnpm dev; prefer an absolute local path.
DATABASE_PATH=../../.data/northtrail
# Neon production connection must require TLS. Keep credentials server-side.
DATABASE_URL=
UNISWAP_API_KEY=
# Optional read-only receipt observation. HTTPS, or HTTP loopback for a local node.
RPC_URL=
RPC_SECONDARY_URL=
TRADING_ENABLED=false
GIT_SHA=local
# Read-only acquisition is separately opt-in; it never enables trading.
UNISWAP_QUOTING_ENABLED=false
ONEINCH_QUOTING_ENABLED=false
ONEINCH_API_KEY=
